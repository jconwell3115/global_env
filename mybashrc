# .bashrc

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]
then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH


# Environment Variables
export WORK_ENV_DIR="$HOME/Work_Environments"
export WORK_TOOLS_DIR="$HOME/my_work_tools"
export BIN_DIR="$WORK_TOOLS_DIR/bin/"
export GLOBAL_ENV_DIR="$WORK_TOOLS_DIR/global_env"
export SSH_DIR="$HOME/.ssh"
export USERNAME="Jonathan Conwell"
export KEY_NAME="id_ed25519"
export KEY_PATH="$HOME/.ssh/$KEY_NAME"
export KEY_TYPE="ed25519"
export KEY_SIZE="2048"
export EMAIL="jconwell3115@gmail.com"
export PYTHON_VERSION="3.12"
export UV_CACHE_DIR="$HOME/.uv-cache"
export UV_GLOBAL_TOOLS="ruff mypy pylint bandit pydocstyle ansible-lint yamllint djlint pymarkdownlnt pre-commit"
export UV_CHANNEL="https://astral.sh/uv/install.sh"


# Source shared shell functions
[ -f "$HOME/my_work_tools/global_env/shell_functions.sh" ] && source "$HOME/my_work_tools/global_env/shell_functions.sh"

# Only output for interactive shells
if [[ $- == *i* ]]; then
    echo ""
    echo "*** Read ~/.bashrc ***"
    echo ""
    # other commands that produce output
fi


PS1='\[\e[0;32m\]\u@\h \[\e[1;33m\]\w \[\e[0;36m\]$ \[\e[m\]'
PROMPT_DIRTRIM=2

# User specific aliases and functions

# .bashrc commands
alias readbash='source ~/.bashrc'
alias configbash='vi ~/.bashrc'
alias cpbash='cp -pr ~/my_work_tools/global_env/mybashrc ~/.bashrc'
alias catbash='cat ~/.bashrc'
alias diffbash='diff ~/my_work_tools/global_env/mybashrc ~/.bashrc'

# Navigation shortcuts
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias W='cd ~/Work_Environments'
alias T="cd ~/my_work_tools"

# Enhanced listing
alias ll='ls -Alh'  # List all files including hidden
alias l='ls -CF'  # List with indicators
alias lld='du -sh'  # List directory sizes
alias duh='du -sh * | sort -h'  # List all items in current dir by size

# SSH Shortcuts
alias rhlabs='ssh rhlabs@192.168.0.100'

# Python shortcuts
alias py='python3'
alias uvdo='source .venv/bin/activate'  # For local virtual envs
alias envsetup='~/my_work_tools/global_env/environment_setup.sh'  # Setup environment
alias uvsetup='~/my_work_tools/global_env/new_uv_setup.sh'  # Migrate to UV

# Miscellaneous
alias c='clear'
alias h='history'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias mkdir='mkdir -p'  # Create parent dirs automatically
  
# Macro aliases
alias srcsh='source $HOME/my_work_tools/global_env/shell_functions.sh'
alias scb="search_config_blocks"
alias cgf='copy_global_files'
alias doit='pipenv shell'
alias findpip="python3 -m pip config debug"
alias findtodo="grep -r --exclude-dir={.collections,avd,arista} --include='*.py' -nE 'TODO|FIXME' ."
alias upp='update_project_pyproject_tools'
alias cpc='copy_precommit_config'
alias cci='copy_copilot_instructions'
alias cgr='copy_global_requirements'
alias rp='renew_project'
alias pvm='podman_volume_mounts'
alias pvls='podman_volume_ls'

# Shell Shortcuts
alias lh="$HOME/my_work_tools/bin/bash/lookup_hosts.sh"
alias dc="$HOME/my_work_tools/bin/bash/data_converter.sh"

# Git aliases
alias gital='git config --get-regexp alias'
