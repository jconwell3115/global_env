[MASTER]
# A minimal, recommended pylintrc tuned to this codebase.
# Adjust as needed.
ignore=venv,.venv
jobs=1
init-hook='import sys; sys.path.append(".")'

[MESSAGES CONTROL]
# Disable some docstring checks (we use pydocstyle separately) and other noisy checks
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0903,  # too-few-public-methods
    R0201,  # no-self-use

[FORMAT]
max-line-length=90
indent-string='    '

[REPORTS]
output-format=colorized
score=no

[TYPECHECK]
# Allow dynamic members commonly used in network SDKs
generated-members=requests.*,netmiko.*,pynautobot.*

[BASIC]
good-names=i,j,k,ex,Run,_,pk,id

[SIMILARITIES]
min-similarity-lines=4
